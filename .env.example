# Reference for the ignored root .env. This file contains no credentials.
# For fresh setup, run python3 docker/init.py env (or scripts/native.py init)
# to generate real dashboard secrets and this checkout's absolute paths.
# Do not copy the blank credential values into an existing working .env.

# Docker project/mount settings. The initializer uses your actual UID/GID.
# Existing WORKSHOP_UID / WORKSHOP_GID values are also supported; keep your
# current .env. Non-empty HOST_UID / HOST_GID take precedence when both exist.
COMPOSE_PROJECT_NAME=demo-agents
DEMO_PROJECT=/absolute/path/to/demo-agents
HOST_UID=1000
HOST_GID=1000

# Native OpenClaw: UI changes save to the full config in the repository.
# For an existing installation, preserve its selected state and home paths.
# Docker uses its own container paths and private volumes instead.
OPENCLAW_CONFIG_PATH=/absolute/path/to/demo-agents/config/openclaw.json
OPENCLAW_STATE_DIR=/absolute/path/to/demo-agents/.local/native/openclaw
OPENCLAW_HOME=/absolute/path/to/demo-agents/.local/native/openclaw-home
# The launcher computes OPENCLAW_WORKSPACE_DIR, OPENCLAW_AGENT_DIR and
# OPENCLAW_LOG_FILE for this checkout; do not point them at another profile.
# Optional native Gateway port for a second checkout on one host. It must match
# gateway.port and the controlUi origins in config/openclaw.json. Default 18789.
# OPENCLAW_GATEWAY_PORT=18789

# Required dashboard credentials, generated privately by the initializer.
OPENCLAW_GATEWAY_TOKEN=
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# Required only when the active config enables the Telegram bot.
# Enter your existing token privately; the JSON stores an environment reference.
TELEGRAM_BOT_TOKEN=

# Optional Discord team: one bot per agent, configured by
# scripts/configure_discord_collaboration.py (see README-discord-collaboration.md).
# Put these in this file or in .local/openclaw.env. Discord IDs are not
# credentials, but they identify your server and account, so keep them private.
# Shared values:
# OPENCLAW_PRIVATE_DISCORD_GUILD_ID=
# OPENCLAW_PRIVATE_DISCORD_USER_ID=
# OPENCLAW_PRIVATE_DISCORD_TEAM_CHANNEL_ID=
# Chief of Staff bot (required for the Discord team):
# DISCORD_BOT_TOKEN=
# OPENCLAW_PRIVATE_DISCORD_MAIN_APPLICATION_ID=
# OPENCLAW_PRIVATE_DISCORD_MAIN_BOT_USER_ID=
# OPENCLAW_PRIVATE_DISCORD_MAIN_CHANNEL_ID=
# Further agents, each optional. Role suffixes: CTO, SWE, QA, UI_UX, CONTENT,
# GENERALIST, INFRASTRUCTURE, SALES. The CHANNEL_ID (a dedicated room) is optional.
# DISCORD_CTO_BOT_TOKEN=
# OPENCLAW_PRIVATE_DISCORD_CTO_APPLICATION_ID=
# OPENCLAW_PRIVATE_DISCORD_CTO_BOT_USER_ID=
# OPENCLAW_PRIVATE_DISCORD_CTO_CHANNEL_ID=

# Optional private values for a customized configuration; fresh starters omit them.
# If you add these references, use your own account/model/owner values.
# A model reference keeps its provider prefix in JSON and its private part here.
OPENCLAW_PRIVATE_ACCOUNT_EMAIL=
OPENCLAW_PRIVATE_DEFAULT_MODEL=
OPENCLAW_PRIVATE_OWNER_1=

# Optional OpenClaw API credentials; subscription login can use private state.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AGENTMAIL_API_KEY=

# Optional semantic memory search (README-memory.md). The tracked config uses
# local keyword search; switch memory.search.provider to openai and reference
# this variable from memory.search.remote.apiKey. Set it privately in
# .local/openclaw.env. It does not replace chat subscription login.
# OPENAI_EMBEDDINGS_API_KEY=

# Optional GBrain overlay (README-gbrain.md). scripts/gbrain.py writes the
# reader tokens into .local/openclaw.env; the tracked config references them.
# GBRAIN_PORT=3131

# Optional Paperclip control plane (README-paperclip.md). Both default ports
# are free on a fresh host; change them for a second instance.
# PAPERCLIP_PORT=3100
# PAPERCLIP_DB_PORT=54329

# Hermes provider/Telegram secrets belong in .local/native/hermes/.env for native
# or /opt/data/.env in its Docker volume, never in this tracked example.
