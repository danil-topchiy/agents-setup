.DS_Store
# Private dotenv values stay local; commit only the credential-free example.
.env
.env.*
!.env.example
.local/
.openclaw/
.hermes/
operator-paths.sh
*.pem
*.key
*.db
*.db-*
*.sqlite*
*.log
# OpenClaw creates these alongside the tracked active native config.
config/openclaw.json.bak*
config/openclaw.json.last-good
config/openclaw.json.rejected.*
config/openclaw.json.tmp*
# Account metadata and backups stay private even though settings are versioned.
config/*.private.json
config/*.private.json.*
**/output/
**/memory/
__pycache__/
*.pyc
node_modules/
# Live specialist memory and per-device Obsidian state stay local.
openclaw/workspace/agents/*/MEMORY.md
**/.obsidian/workspace*.json
**/.obsidian/cache/
**/.obsidian/plugins/
**/.trash/
# Paperclip agent keys never belong in a workspace commit.
openclaw/workspace/**/paperclip-claimed-api-key.json
