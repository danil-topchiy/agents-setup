{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "allowTailscale": false,
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "tailscale": {
      "mode": "off"
    },
    "terminal": {
      "enabled": false
    },
    "cliAgents": {
      "enabled": false
    },
    "port": 18789,
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "skipBootstrap": true,
      "skills": [],
      "heartbeat": {
        "every": "0m"
      },
      "workspace": "${OPENCLAW_WORKSPACE_DIR}",
      "systemAgent": {
        "agentId": "main"
      },
      "subagents": {
        "allowAgents": [
          "main",
          "cto",
          "swe",
          "qa",
          "ui-ux",
          "content",
          "generalist",
          "infrastructure",
          "sales"
        ],
        "requireAgentId": true,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 2,
        "maxConcurrent": 4,
        "runTimeoutSeconds": 600,
        "delegationMode": "suggest"
      },
      "compaction": {
        "memoryFlush": {
          "enabled": true
        }
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "name": "Chief of Staff",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}",
        "agentDir": "${OPENCLAW_AGENT_DIR}",
        "identity": {
          "name": "Chief of Staff"
        },
        "groupChat": {
          "mentionPatterns": [
            "@ChiefOfStaff\\b",
            "@CoS\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "cto": {
        "name": "CTO",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/cto",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/cto/agent",
        "identity": {
          "name": "CTO",
          "emoji": "🧭",
          "theme": "Calm, decisive, and practical."
        },
        "groupChat": {
          "mentionPatterns": [
            "@CTO\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "swe": {
        "name": "SWE",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/swe",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/swe/agent",
        "identity": {
          "name": "SWE",
          "emoji": "🛠️",
          "theme": "Focused, careful, and straightforward."
        },
        "groupChat": {
          "mentionPatterns": [
            "@SWE\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "qa": {
        "name": "QA",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/qa",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/qa/agent",
        "identity": {
          "name": "QA",
          "emoji": "🔎",
          "theme": "Calm, skeptical, and evidence-first."
        },
        "groupChat": {
          "mentionPatterns": [
            "@QA\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "ui-ux": {
        "name": "UI/UX",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/ui-ux",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/ui-ux/agent",
        "identity": {
          "name": "UI/UX",
          "emoji": "🎨",
          "theme": "Observant, thoughtful, and precise."
        },
        "groupChat": {
          "mentionPatterns": [
            "@UIUX\\b",
            "@UI-UX\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "content": {
        "name": "Content",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/content",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/content/agent",
        "identity": {
          "name": "Content",
          "emoji": "✍️",
          "theme": "Clear, curious, and attentive to voice."
        },
        "groupChat": {
          "mentionPatterns": [
            "@Content\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "generalist": {
        "name": "Generalist",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/generalist",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/generalist/agent",
        "identity": {
          "name": "Generalist",
          "emoji": "🧩",
          "theme": "Resourceful, adaptable, and grounded."
        },
        "groupChat": {
          "mentionPatterns": [
            "@Generalist\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "infrastructure": {
        "name": "Infrastructure",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/infrastructure",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/infrastructure/agent",
        "identity": {
          "name": "Infrastructure",
          "emoji": "🏗️",
          "theme": "Methodical, steady, and operationally precise."
        },
        "groupChat": {
          "mentionPatterns": [
            "@Infrastructure\\b",
            "@Infra\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      },
      "sales": {
        "name": "Sales",
        "workspace": "${OPENCLAW_WORKSPACE_DIR}/agents/sales",
        "agentDir": "${OPENCLAW_STATE_DIR}/agents/sales/agent",
        "identity": {
          "name": "Sales",
          "emoji": "🤝",
          "theme": "Curious, commercially aware, and respectful."
        },
        "groupChat": {
          "mentionPatterns": [
            "@Sales\\b"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": [
              "${OPENCLAW_WORKSPACE_DIR}/knowledge"
            ]
          }
        }
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "read",
      "write",
      "exec",
      "skill_workshop",
      "group:memory",
      "sessions_spawn",
      "sessions_yield",
      "subagents"
    ],
    "deny": [
      "edit",
      "apply_patch",
      "group:automation",
      "group:web",
      "group:ui",
      "group:messaging",
      "group:nodes",
      "sessions_send",
      "*__*"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "mode": "ask"
    },
    "elevated": {
      "enabled": false
    },
    "sessions": {
      "visibility": "tree"
    },
    "agentToAgent": {
      "enabled": false
    },
    "codeMode": {
      "enabled": false
    },
    "toolSearch": false
  },
  "browser": {
    "enabled": false
  },
  "cron": {
    "enabled": false
  },
  "hooks": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "plugins": {
    "entries": {
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "codex": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "skills": {
    "entries": {
      "1password": {
        "enabled": false
      },
      "apple-notes": {
        "enabled": false
      },
      "apple-reminders": {
        "enabled": false
      },
      "bear-notes": {
        "enabled": false
      },
      "blucli": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "coding-agent": {
        "enabled": false
      },
      "eightctl": {
        "enabled": false
      },
      "gifgrep": {
        "enabled": false
      },
      "goplaces": {
        "enabled": false
      },
      "himalaya": {
        "enabled": false
      },
      "mcporter": {
        "enabled": false
      },
      "model-usage": {
        "enabled": false
      },
      "nano-pdf": {
        "enabled": false
      },
      "obsidian": {
        "enabled": false
      },
      "openai-whisper": {
        "enabled": false
      },
      "openai-whisper-api": {
        "enabled": false
      },
      "openhue": {
        "enabled": false
      },
      "oracle": {
        "enabled": false
      },
      "ordercli": {
        "enabled": false
      },
      "peekaboo": {
        "enabled": false
      },
      "sag": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      },
      "songsee": {
        "enabled": false
      },
      "sonoscli": {
        "enabled": false
      },
      "spotify-player": {
        "enabled": false
      },
      "things-mac": {
        "enabled": false
      },
      "tmux": {
        "enabled": false
      },
      "trello": {
        "enabled": false
      }
    },
    "workshop": {
      "autonomous": {
        "mode": "auto"
      }
    }
  },
  "logging": {
    "file": "${OPENCLAW_LOG_FILE}"
  },
  "telemetry": {
    "enabled": false
  },
  "talk": {
    "agentId": "main"
  },
  "memory": {
    "citations": "on",
    "search": {
      "enabled": true,
      "provider": "none",
      "sources": [
        "memory"
      ],
      "rememberAcrossConversations": false
    }
  }
}
